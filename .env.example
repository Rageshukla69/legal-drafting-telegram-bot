# ==============================
# TELEGRAM
# ==============================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Your Telegram numeric user ID
OWNER_TELEGRAM_ID=your_telegram_user_id


# ==============================
# GEMINI
# ==============================
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash


# ==============================
# AZURE SPEECH — EXISTING VOICE
# ==============================
AZURE_SPEECH_KEY=your_azure_speech_key
AZURE_SPEECH_REGION=centralindia


# ==============================
# AZURE DOCUMENT INTELLIGENCE
# ==============================
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://legal-drafting-bot-intel.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=your_document_intelligence_key
AZURE_DOCUMENT_INTELLIGENCE_MODEL=prebuilt-layout

# Maximum OCR text sent to Gemini per chunk
IMAGE_INTAKE_CHUNK_CHARS=60000


# ==============================
# AZURE COSMOS DB
# ==============================
COSMOS_ENDPOINT=your_cosmos_endpoint
COSMOS_KEY=your_cosmos_key
COSMOS_DATABASE=legal_drafting_bot
COSMOS_CONTAINER=cases
COSMOS_THROUGHPUT=400


# ==============================
# DOCUMENT OUTPUT
# ==============================
LEGAL_PAPER=legal
