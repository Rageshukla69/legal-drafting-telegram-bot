# ==============================
# TELEGRAM
# ==============================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Your Telegram numeric user ID
OWNER_TELEGRAM_ID=your_telegram_user_id


# ==============================
# GEMINI
# ==============================
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=90
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BACKOFF_SECONDS=1.5
GEMINI_RETRY_BACKOFF_MAX_SECONDS=60
GEMINI_INTAKE_THINKING_LEVEL=medium
GEMINI_PLANNING_THINKING_LEVEL=medium
GEMINI_DRAFTING_THINKING_LEVEL=high
GEMINI_INTAKE_HISTORY_MESSAGES=40
GEMINI_INTAKE_HISTORY_CHARS=80000


# ==============================
# AZURE SPEECH — EXISTING VOICE
# ==============================
AZURE_SPEECH_KEY=your_azure_speech_key
AZURE_SPEECH_REGION=centralindia
# Optional explicit endpoint; if omitted, REGION is used to derive:
# https://<AZURE_SPEECH_REGION>.api.cognitive.microsoft.com
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_MODEL=MAI-Transcribe-2
AZURE_SPEECH_API_VERSION=2025-10-15
AZURE_SPEECH_TIMEOUT_SECONDS=90
AZURE_SPEECH_MAX_RETRIES=3
AZURE_SPEECH_RETRY_BACKOFF_SECONDS=1.5
AZURE_SPEECH_RETRY_BACKOFF_MAX_SECONDS=60
AZURE_SPEECH_FFMPEG_TIMEOUT_SECONDS=45
# Optional comma-separated locale hints; leave empty for auto-detect.
AZURE_SPEECH_LOCALES=hi-IN,en-IN


# ==============================
# AZURE DOCUMENT INTELLIGENCE
# ==============================
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://legal-drafting-bot-intel.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=your_document_intelligence_key
AZURE_DOCUMENT_INTELLIGENCE_MODEL=prebuilt-layout

# Maximum OCR text sent to Gemini per chunk
IMAGE_INTAKE_CHUNK_CHARS=60000
AZURE_DOCUMENT_INTELLIGENCE_API_VERSION=2024-11-30
AZURE_DOCUMENT_INTELLIGENCE_TIMEOUT_SECONDS=600
AZURE_DOCUMENT_INTELLIGENCE_POLL_SECONDS=1.5


# ==============================
# AZURE COSMOS DB
# ==============================
COSMOS_ENDPOINT=your_cosmos_endpoint
COSMOS_KEY=your_cosmos_key
COSMOS_DATABASE=legal_drafting_bot
COSMOS_CONTAINER=cases
COSMOS_THROUGHPUT=400


# ==============================
# DOCUMENT OUTPUT
# ==============================
LEGAL_PAPER=legal
LEGAL_PDF_ENGINE=canonical
LEGAL_PDF_REQUIRE_CANONICAL=0
DOCX_PDF_TIMEOUT_SECONDS=300
# Optional explicit binary path when soffice is not on PATH
SOFFICE_BIN=
